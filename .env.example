# Copy locally to .env; never put actual keys in a tracked file.
# CLI: adaptive-rag --env-file .env ...
RAG_ENABLE_CLOUD=false
# Optional query and quality modules; see docs/deepseek-rag.md for provider selection.
RAG_ENABLE_QUERY_PREPARATION=false
RAG_ENABLE_QUALITY_CHECKS=false
RAG_ENABLE_MULTI_QUERY=false
RAG_ENABLE_HYDE=false
# "Not found" check (docs/relevance.md): drop retrieved chunks that are not the same as or similar to the question.
RAG_RELEVANCE_GATE=true
RAG_RELEVANCE_LEXICAL_FLOOR=0.3
RAG_RELEVANCE_RERANK_FLOOR=0.05
RAG_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_CLOUD_API_KEY=
RAG_LLM_MODEL=deepseek-v4.1-flash-1017
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RAG_RERANK_MODEL=qwen3.7-text-rerank
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_KEY=
RAG_PDF_BACKEND=local
# Password of the fixed administrator "ragadmin" (6-128 characters, no control characters).
# Required the first time a data directory is used; changing it later replaces the stored password at the next start.
RAG_ADMIN_PASSWORD=
# Browser login does not require a token. Optional Bearer credentials are for API clients.
RAG_HTTP_API_TOKEN=
RAG_HTTP_TENANT=demo
RAG_HTTP_SUBJECT=admin

# Optional intent router, independent of Bailian. Opt in after filling the DeepSeek key.
RAG_ENABLE_DEEPSEEK_INTENT=false
DEEPSEEK_API_KEY=
RAG_DEEPSEEK_INTENT_MODEL=deepseek-flash
# Separately opt in to sending authorized evidence to DeepSeek for cited answers and verification.
RAG_ENABLE_DEEPSEEK_ANSWERS=false
RAG_DEEPSEEK_ANSWER_MODEL=deepseek-flash
