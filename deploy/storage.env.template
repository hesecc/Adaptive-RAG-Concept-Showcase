# Copy into a private file outside Git. These are placeholders, not credentials.
RAG_ENABLE_REMOTE_STORAGE=true
# Keep this equal to RAG_STORAGE_TENANT and the existing accounts database tenant.
RAG_HTTP_TENANT=demo
RAG_STORE_BACKEND=postgres
RAG_TRACE_BACKEND=postgres
RAG_ASSET_STORE_BACKEND=postgres
RAG_OBJECT_BACKEND=s3
RAG_ASSET_VECTOR_BACKEND=milvus
RAG_POSTGRES_DSN=postgresql://rag:CHANGE_ME@postgres:5432/rag
# Use a separately provisioned S3-compatible service; no shared project bucket.
# This URL must be reachable from the application and worker containers.
RAG_S3_ENDPOINT=https://s3.your-service.example
RAG_S3_ACCESS_KEY=CHANGE_ME
RAG_S3_SECRET_KEY=CHANGE_ME
RAG_S3_BUCKET=an-rag-assets
RAG_S3_REGION=us-east-1
RAG_S3_PREFIX=objects
RAG_MILVUS_ENDPOINT=http://milvus:19530
RAG_MILVUS_COLLECTION=an_rag_asset_text_v1
RAG_MILVUS_TOKEN=
# Optional, must match the configured text Embedding model when specified.
# RAG_ASSET_EMBEDDING_DIMENSIONS=1024
# Model credentials are configured separately. Remote storage never enables models.
